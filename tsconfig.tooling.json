{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "node_modules/.tsc/tooling",
    "tsBuildInfoFile": "node_modules/.tsc/tooling.tsbuildinfo",
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "*.ts",
    "e2e/**/*.ts",
    "tools/**/*.ts",
    "packages/shared/src/**/*.ts",
    "packages/shared/src/**/*.json"
  ]
}
